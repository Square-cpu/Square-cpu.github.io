---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../lib/paths';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { data } = project;
---
<BaseLayout title={data.title} description={data.summary}>
  <article>
    <header class="page-heading stack">
      <a class="text-link" href={withBase('projects/')}>← Back to Projects</a>
      <p class="eyebrow">Project / case study in progress</p>
      <h1>{data.title}</h1>
      <p class="lead reading muted">{data.summary}</p>
      <dl>
        <div><dt>Year</dt><dd>{data.year ?? 'To be added'}</dd></div>
        <div><dt>Role</dt><dd>{data.role ?? 'To be added'}</dd></div>
        {data.status && <div><dt>Status</dt><dd>{data.status}</dd></div>}
        {data.categories.length > 0 && <div><dt>Categories</dt><dd>{data.categories.join(' / ')}</dd></div>}
        {data.technologies.length > 0 && <div><dt>Technologies</dt><dd>{data.technologies.join(', ')}</dd></div>}
      </dl>
      {data.links.length > 0 && <ul>{data.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>}
    </header>
    {data.cover && <Image src={data.cover.src} alt={data.cover.alt} />}
    <slot name="media" />
    <div class="section"><slot /></div>
    <slot name="experiments" />
    <nav class="section stack" aria-label="Project navigation">
      <a href={withBase('projects/')}>← All projects</a>
      <slot name="project-navigation" />
    </nav>
  </article>
</BaseLayout>
<style>
  dl { display: flex; flex-wrap: wrap; gap: var(--space-5) var(--space-7); }
  dt { font-family: var(--font-mono); font-size: var(--text-small); color: var(--color-muted); }
  dd { margin: var(--space-2) 0 0; }
</style>
