---
import { site } from '../../data/site';
import BrandIcon from './BrandIcon.astro';
interface Props { variant?: 'default' | 'footer'; }
const { variant = 'default' } = Astro.props;
---
{variant === 'footer' ? (
  <div class="footer-contacts">
    <ul class="footer-contact-list">
      {site.contactLinks.map(link => <li><a href={link.href}><span class="contact-label"><BrandIcon brand={link.brand} /><span>{link.label}</span></span><span aria-hidden="true">↗</span><span class="destination-note"> (external destination)</span></a></li>)}
    </ul>
  </div>
) : (
  <ul class="contact-links">
    {site.contactLinks.map(link => <li><a href={link.href}><BrandIcon brand={link.brand} /><span>{link.label}</span><span aria-hidden="true">↗</span><span class="destination-note"> (external destination)</span></a></li>)}
  </ul>
)}
<style>
  .contact-links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-5); }
  .contact-links a, .contact-label { display: inline-flex; align-items: center; gap: var(--space-2); }
  .contact-links a { min-height: var(--size-touch-target); }
  .footer-contact-list { list-style: none; padding: 0; margin: var(--space-4) 0 0; }
  .footer-contact-list li { min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); padding-block: var(--space-3); border-bottom: var(--border-thin) solid var(--color-border); }
  .footer-contact-list a { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: var(--size-touch-target); padding-block: var(--space-2); }
  .destination-note { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
