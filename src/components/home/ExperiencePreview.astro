---
import { withBase } from '../../lib/paths';
import { experiencePreview } from '../../data/experiences';
import SectionLabel from '../common/SectionLabel.astro';
---
<section class="experience-preview" aria-labelledby="experiences-heading">
  <SectionLabel number="05">Experience / journey</SectionLabel>
  <div class="journey layout-grid">
    <div class="journey-introduction">
      <h2 id="experiences-heading">Learning environments</h2>
      <p class="muted">Programs and communities where I’ve learned and built things.</p>
    </div>
    <ul class="journey-path" aria-label="Learning programs and communities">
      {experiencePreview.map(entry => (
        <li>
          <p class="journey-date eyebrow">{entry.period}</p>
          <div class="journey-entry">
            <h3>{entry.title}</h3>
            <p class="muted">{entry.summary}</p>
          </div>
        </li>
      ))}
    </ul>
    <a class="journey-link text-link" href={withBase('experiences/')}>Explore experiences <span aria-hidden="true">→</span></a>
  </div>
</section>
<style>
  .experience-preview { border-top: var(--border-thin) solid var(--color-border-strong); padding-block: var(--space-7) var(--space-section); }
  .journey { margin-top: var(--space-7); row-gap: var(--space-5); }
  .journey-introduction, .journey-path, .journey-link { grid-column: 1 / -1; }
  h2 { max-width: 14ch; }
  .journey-introduction p { margin-top: var(--space-4); max-width: 28ch; }
  .journey-path { list-style: none; padding: 0; margin: 0; }
  li { display: grid; gap: var(--space-3); border-top: var(--border-thin) solid var(--color-border); padding-block: var(--space-4); }
  .journey-date { padding-top: var(--space-1); }
  h3 { font-size: var(--text-lead); font-weight: 500; }
  .journey-entry p { margin-top: var(--space-2); max-width: 35ch; }
  .journey-link { justify-self: start; }
  @media (min-width: 48rem) {
    .experience-preview { padding-top: var(--space-8); }
    .journey { row-gap: var(--space-7); }
    .journey-introduction { grid-column: 1 / 6; }
    .journey-path, .journey-link { grid-column: 6 / -1; }
    li { padding-block: var(--space-5) var(--space-6); }
    li:nth-child(2) { margin-left: var(--space-7); }
    li:nth-child(3) { margin-left: var(--space-5); }
  }
  @media (min-width: 64rem) {
    li { grid-template-columns: minmax(6rem, 1fr) minmax(0, 3fr); gap: var(--space-5); }
  }
</style>
