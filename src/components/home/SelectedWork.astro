---
import { getFeaturedProjects } from '../../lib/projects';
import { withBase } from '../../lib/paths';
import ProjectPreview from '../projects/ProjectPreview.astro';
import ProjectStudy from '../projects/ProjectStudy.astro';
import ProjectMedia from '../projects/ProjectMedia.astro';
import { featuredPresentation, defaultFeaturedPresentation } from '../../data/featured-presentation';
const projects = await getFeaturedProjects();
---
<section class="selected-work" aria-labelledby="work-heading">
  <header class="work-introduction">
    <h2 id="work-heading" class="eyebrow"><span aria-hidden="true">04 / </span>Selected work</h2>
    <p class="muted">Case studies in progress.</p>
  </header>
  <div class="exhibition layout-grid">
    {projects.map((project, index) => {
      const presentation = featuredPresentation[project.id] ?? defaultFeaturedPresentation;
      return <ProjectPreview project={project} context="selected" index={index} variant={presentation.variant}>
        {project.data.cover ? <ProjectMedia slot="media" project={project} variant={presentation.variant} /> : <ProjectStudy slot="media" study={presentation.study} />}
      </ProjectPreview>;
    })}
  </div>
  <div class="work-ending"><a class="text-link" href={withBase('projects/')}>View all projects <span aria-hidden="true">→</span></a></div>
</section>
<style>
  .selected-work { padding-block: var(--space-6) var(--space-section); }
  .work-introduction { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-3); margin-bottom: var(--space-7); }
  h2 { font-weight: 400; line-height: var(--leading-body); letter-spacing: 0.08em; }
  .work-introduction p { font-size: var(--text-small); }
  .exhibition { row-gap: var(--space-8); }
  .work-ending { margin-top: var(--space-8); padding-top: var(--space-5); border-top: var(--border-thin) solid var(--color-border); text-align: right; }
  @media (min-width: 48rem) {
    .exhibition { row-gap: var(--space-section); }
    .work-introduction { margin-bottom: var(--space-8); }
  }
</style>
