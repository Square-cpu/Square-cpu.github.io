---
import { getFeaturedProjects } from '../../lib/projects';
import { withBase } from '../../lib/paths';
import ProjectPreview from '../projects/ProjectPreview.astro';
const projects = await getFeaturedProjects();
---
<section class="section stack" aria-labelledby="work-heading">
  <p class="eyebrow">04 / Curated exhibition</p>
  <h2 id="work-heading">Selected work</h2>
  <p class="muted">Six projects. Case studies in progress.</p>
  <div>{projects.map((project, index) => <ProjectPreview project={project} context="selected" index={index} />)}</div>
  <a class="text-link" href={withBase('projects/')}>Explore the complete project archive →</a>
</section>
