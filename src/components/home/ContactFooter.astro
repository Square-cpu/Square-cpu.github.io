---
import ContactLinks from '../common/ContactLinks.astro';
import { navigation, site } from '../../data/site';
import { withBase } from '../../lib/paths';
import SectionLabel from '../common/SectionLabel.astro';
import FooterMark from '../interactive/FooterMark.astro';
interface Props { home?: boolean; }
const { home = false } = Astro.props;
---
{home ? (
<footer class="home-footer" aria-labelledby="contact-heading">
  <div class="shell">
    <SectionLabel number="08">Contact</SectionLabel>
    <div class="footer-conversation layout-grid">
      <h2 id="contact-heading">Want to talk?</h2>
      <div class="footer-contact-area"><ContactLinks variant="footer" /></div>
    </div>
    <noscript>
      <nav id="footer-index" aria-label="Site index"><ul>{navigation.map(item => <li><a href={withBase(item.path)}>{item.label}</a></li>)}</ul></nav>
    </noscript>
    <div class="footer-ending">
      <p>{site.name}</p>
      <p class="eyebrow"><span>{new Date().getFullYear()}</span><span>Portfolio in progress</span></p>
      <FooterMark />
    </div>
  </div>
</footer>
) : (
<footer class="shell section stack" aria-labelledby="contact-heading">
  <p class="eyebrow">{home ? '08 / Contact' : 'Contact'}</p>
  <h2 id="contact-heading">Find me elsewhere</h2>
  <ContactLinks />
  <noscript>
    <nav id="footer-index" aria-label="Site index"><ul>{navigation.map((item) => <li><a href={withBase(item.path)}>{item.label}</a></li>)}</ul></nav>
  </noscript>
  <p class="eyebrow">{site.name} <span aria-hidden="true">/</span> Portfolio in progress</p>
</footer>
)}
<style>
  .home-footer { background: var(--color-surface); padding-block: var(--space-8) var(--space-6); }
  .footer-conversation { margin-top: var(--space-6); row-gap: var(--space-7); align-items: start; }
  h2, .footer-contact-area { grid-column: 1 / -1; min-width: 0; }
  .home-footer h2 { font-size: var(--text-title); letter-spacing: -0.045em; max-width: 10ch; }
  .footer-contact-area { max-width: 26rem; }
  .footer-ending { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-5); margin-top: var(--space-8); padding-top: var(--space-5); border-top: var(--border-thin) solid var(--color-border-strong); align-items: center; }
  .footer-ending > p:first-child { font-size: var(--text-body); }
  .footer-ending .eyebrow { grid-row: 2; grid-column: 1; display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .footer-ending :global(.footer-mark) { grid-column: 2; grid-row: 1 / 3; }
  .home-footer nav { margin-top: var(--space-7); }
  .home-footer nav ul { list-style: none; padding: 0; }
  .home-footer nav a { display: inline-block; padding-block: var(--space-3); min-height: 44px; }
  @media (min-width: 48rem) {
    .home-footer { padding-top: var(--space-section); }
    .home-footer h2 { grid-column: 1 / 9; }
    .footer-contact-area { grid-column: 9 / -1; }
    .footer-ending { margin-top: var(--space-9); grid-template-columns: minmax(0, 1fr) auto auto; gap: var(--space-7); }
    .footer-ending .eyebrow { grid-row: 1; grid-column: 2; }
    .footer-ending :global(.footer-mark) { grid-row: 1; grid-column: 3; }
  }
</style>
