---
import { withBase } from '../../lib/paths';
import SectionLabel from '../common/SectionLabel.astro';
import PlaygroundArtifact from './PlaygroundArtifact.astro';
const studies = ['frames', 'wire', 'drawing', 'fragment'] as const;
---
<section class="playground-preview" aria-labelledby="playground-heading">
  <SectionLabel number="06">Playground</SectionLabel>
  <div class="playground-introduction layout-grid">
    <h2 id="playground-heading">Playground</h2>
    <p class="muted">Animation, drawings, creative coding, and small experiments.<br />Temporary artifact slots below; entries to come.</p>
  </div>
  <div class="workbench layout-grid" aria-hidden="true">
    {studies.map(kind => <div class:list={['artifact-slot', `artifact-${kind}`]}><PlaygroundArtifact kind={kind} /></div>)}
  </div>
  <div class="playground-ending"><a class="text-link" href={withBase('playground/')}>Visit the playground <span aria-hidden="true">→</span></a></div>
</section>
<style>
  .playground-preview { padding-bottom: var(--space-section); }
  .playground-introduction { margin-top: var(--space-5); align-items: end; row-gap: var(--space-5); }
  h2, .playground-introduction p { grid-column: 1 / -1; }
  .playground-introduction p { max-width: 42ch; }
  .workbench { margin-top: var(--space-7); row-gap: var(--space-5); align-items: start; }
  .artifact-slot { min-width: 0; }
  .artifact-frames { grid-column: 1 / -1; }
  .artifact-wire { grid-column: 1 / 3; }
  .artifact-drawing { grid-column: 3 / -1; margin-top: var(--space-7); }
  .artifact-fragment { grid-column: 2 / -1; }
  .playground-ending { margin-top: var(--space-7); }
  .artifact-wire :global(svg) { transition: transform var(--motion-normal) var(--ease-standard); }
  @media (hover: hover) and (pointer: fine) { .artifact-wire:hover :global(svg) { transform: rotate(3deg) translateY(calc(-1 * var(--space-1))); } }
  .playground-preview:focus-within .artifact-wire :global(svg) { transform: rotate(3deg) translateY(calc(-1 * var(--space-1))); }
  @media (min-width: 48rem) {
    h2 { grid-column: 1 / 7; }
    .playground-introduction p { grid-column: 8 / -1; }
    .workbench { margin-top: var(--space-7); row-gap: var(--space-6); }
    .artifact-frames { grid-column: 1 / 7; }
    .artifact-wire { grid-column: 9 / -1; margin-top: var(--space-6); }
    .artifact-drawing { grid-column: 3 / 6; margin-top: 0; }
    .artifact-fragment { grid-column: 7 / 11; margin-top: var(--space-5); }
    .playground-ending { margin-top: var(--space-5); text-align: right; }
  }
  @media (prefers-reduced-motion: reduce) {
    .artifact-wire:hover :global(svg), .playground-preview:focus-within .artifact-wire :global(svg) { transform: none; }
  }
</style>
