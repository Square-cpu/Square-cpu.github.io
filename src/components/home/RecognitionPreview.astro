---
import { withBase } from '../../lib/paths';
import { getFeaturedRecognition } from '../../data/recognition';
import SectionLabel from '../common/SectionLabel.astro';
const entries = getFeaturedRecognition();
---
<section class="recognition-preview" aria-labelledby="awards-heading">
  <SectionLabel number="07">Recognition</SectionLabel>
  <div class="recognition-layout layout-grid">
    <h2 id="awards-heading">Recognition</h2>
    <div class="recognition-record">
      <table>
        <caption class="muted">A compact record. HM = Honorable Mention.</caption>
        <thead><tr><th scope="col">Distinction</th><th scope="col">Result</th></tr></thead>
        <tbody>
          {entries.map(entry => <tr data-recognition={entry.id}>
            <th scope="row">{entry.name}{entry.fullName && <span class="record-name muted">{entry.fullName}</span>}</th>
            <td>{(entry.summary ?? entry.results.map(result => [result.result, result.year ?? result.period, result.level, result.project].filter(Boolean).join(' · '))).map(line => <span class="record-result">{line}</span>)}</td>
          </tr>)}
        </tbody>
      </table>
      <a class="text-link" href={withBase('awards/')}>View recognition <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
<style>
  .recognition-preview { padding-bottom: var(--space-8); }
  .recognition-layout { margin-top: var(--space-5); row-gap: var(--space-5); }
  h2, .recognition-record { grid-column: 1 / -1; min-width: 0; }
  h2 { font-size: clamp(2rem, 1.5rem + 1.5vw, 3.5rem); }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; text-align: left; }
  caption { text-align: left; padding-bottom: var(--space-5); }
  th, td { padding-block: var(--space-4); padding-right: var(--space-3); border-bottom: var(--border-thin) solid var(--color-border); overflow-wrap: anywhere; vertical-align: top; }
  th { font-weight: 400; }
  thead th, td:not([colspan]) { font-family: var(--font-mono); font-size: var(--text-small); color: var(--color-muted); }
  thead th { text-transform: uppercase; letter-spacing: 0.04em; border-top: var(--border-thin) solid var(--color-border-strong); }
  thead th:first-child { width: 44%; }
  td[colspan] { color: var(--color-muted); }
  .record-name { display: block; margin-top: var(--space-2); font-size: var(--text-small); }
  .record-result { display: block; }
  .record-result + .record-result { margin-top: var(--space-2); }
  .text-link { margin-top: var(--space-4); }
  @media (min-width: 48rem) {
    h2 { grid-column: 1 / 5; }
    .recognition-record { grid-column: 6 / -1; max-width: var(--width-reading); }
  }
</style>
