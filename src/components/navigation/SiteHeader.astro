---
import { site, navigation } from '../../data/site';
import { withBase } from '../../lib/paths';
import ContactLinks from '../common/ContactLinks.astro';
---
<header class="site-header shell">
  <a class="identity" href={withBase()} aria-label={`${site.name} — Home`}>
    <span class="full-name">Arthur Milander</span><span class="initials" aria-hidden="true">AM</span>
  </a>
  <button id="index-trigger" type="button" aria-haspopup="dialog" aria-controls="site-index" aria-expanded="false" hidden>INDEX</button>
  <noscript><a href="#footer-index">INDEX</a></noscript>
</header>
<dialog id="site-index" aria-labelledby="index-title">
  <div class="index-content shell">
    <div class="index-top"><h2 id="index-title" class="eyebrow">Site index</h2><button id="index-close" type="button" autofocus aria-label="Close site index">CLOSE <span aria-hidden="true">×</span></button></div>
    <nav aria-label="Main navigation">
      <ol>{navigation.map((item, index) => (
        <li><a href={withBase(item.path)} aria-current={Astro.url.pathname === withBase(item.path) ? 'page' : undefined}><span class="eyebrow" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{item.label}</a></li>
      ))}</ol>
    </nav>
    <div class="index-contact stack"><p class="eyebrow">Elsewhere / contact</p><ContactLinks /></div>
  </div>
</dialog>
<script>
  const trigger = document.querySelector<HTMLButtonElement>('#index-trigger');
  const dialog = document.querySelector<HTMLDialogElement>('#site-index');
  const close = document.querySelector<HTMLButtonElement>('#index-close');

  if (trigger && dialog && close) {
    trigger.hidden = false;
    trigger.addEventListener('click', () => {
      dialog.showModal(); // Native modality supplies focus containment and makes the page inert.
      trigger.setAttribute('aria-expanded', 'true');
      document.body.classList.add('index-open');
    });
    close.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      // Some browsers let native dialog tabbing reach browser chrome at the ends.
      const controls = dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first?.focus();
      }
    });
    dialog.addEventListener('close', () => {
      trigger.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('index-open');
      trigger.focus({ preventScroll: true });
    });
    // Escape uses the native dialog cancel behavior; ordinary links keep full-page navigation.
    window.addEventListener('pageshow', () => {
      if (dialog.open) dialog.close();
      document.body.classList.remove('index-open');
    });
  }
</script>
<style>
  .site-header, .index-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); padding-block: var(--space-5); }
  .site-header { position: relative; z-index: var(--layer-header); }
  .identity, button { font-family: var(--font-mono); font-size: var(--text-small); text-transform: uppercase; letter-spacing: 0.06em; }
  .identity { text-decoration: none; }
  .initials { display: none; }
  button { border: var(--border-thin) solid var(--color-border); border-radius: var(--radius-small); background: transparent; padding: var(--space-3) var(--space-4); cursor: pointer; min-height: 44px; }
  button:hover { background: var(--color-surface); }
  dialog { inset: 0; margin: 0; width: 100%; height: 100%; height: 100dvh; max-width: none; max-height: none; padding: 0; border: 0; background: var(--color-bg); color: var(--color-text); z-index: var(--layer-overlay); overflow-y: auto; }
  dialog[open] { animation: index-in var(--duration-normal) var(--ease-standard); }
  .index-content { padding-bottom: var(--space-7); }
  ol { list-style: none; margin: var(--space-6) 0; padding: 0; }
  li { border-bottom: var(--border-thin) solid var(--color-border); }
  li a { display: flex; align-items: center; gap: var(--space-5); padding-block: var(--space-4); text-decoration: none; font-size: var(--text-heading); }
  li a[aria-current='page'] { text-decoration: underline; }
  li a:hover { background: var(--color-surface); }
  .index-contact { padding-top: var(--space-5); }
  @keyframes index-in { from { opacity: 0; } to { opacity: 1; } }
  @media (max-width: 30rem) { .full-name { display: none; } .initials { display: inline; } }
</style>
