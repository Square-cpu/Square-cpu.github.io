---
import BaseLayout from '../layouts/BaseLayout.astro';
import { openingCopy } from '../data/opening';
---
<BaseLayout title="About">
  <header class="page-heading stack">
    <p class="eyebrow">Personal notes</p>
    <h1>About Arthur</h1>
    <p class="lead">{openingCopy.aboutHeading}</p>
    <div class="reading stack muted">
      <p>{openingCopy.aboutIntroduction}</p>
      <p>{openingCopy.aboutSupporting}</p>
    </div>
  </header>
</BaseLayout>
